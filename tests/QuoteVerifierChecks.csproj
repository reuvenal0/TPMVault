<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Build TPMVault first. No extra NuGet packages or TPM access for these checks. -->
  <ItemGroup>
    <Reference Include="TPMVault" HintPath="../bin/Debug/net10.0-windows/TPMVault.dll" />
    <Reference Include="TSS.Net" HintPath="../bin/Debug/net10.0-windows/TSS.Net.dll" />
  </ItemGroup>
</Project>
